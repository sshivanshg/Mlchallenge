{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }],
    "beforeSubmitPrompt": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }],
    "afterAgentResponse": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }],
    "preCompact": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }],
    "stop": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }],
    "sessionEnd": [{ "command": "python3 .agent-hooks/log_session.py cursor", "timeout": 10 }]
  }
}
